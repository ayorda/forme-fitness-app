rules_version = '2';
// Private snapshot: users/{uid}/private/snapshot. All eight fields are required.
// format:1, revision:int1..2e9, encoding:gzip|raw, payload:base64<=700000chars,
// rawBytes:int1..12MiB, sha256:64hex, createdAt:immutable timestamp,
// updatedAt:server timestamp. Archive contents are opaque, bounded private data;
// clients independently validate decoding, hash and the complete archive schema.
// No roles, public profiles, cross-user sharing, collection queries or deletion.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid && request.auth.token.email_verified == true; }
    function uidUnchanged() { return !('uid' in request.resource.data); }
    function uidNotModified() { return !('uid' in request.resource.data); }
    function isValidSnapshot(data) {
      return data.keys().hasAll(['format','revision','encoding','payload','rawBytes','sha256','createdAt','updatedAt'])
        && data.keys().hasOnly(['format','revision','encoding','payload','rawBytes','sha256','createdAt','updatedAt'])
        && data.format == 1 && data.revision is int && data.revision >= 1 && data.revision <= 2000000000
        && data.encoding in ['gzip','raw']
        && data.payload is string && data.payload.size() >= 4 && data.payload.size() <= 700000
        && data.payload.matches('^[A-Za-z0-9+/]*={0,2}$')
        && data.rawBytes is int && data.rawBytes >= 1 && data.rawBytes <= 12582912
        && data.sha256 is string && data.sha256.size() == 64 && data.sha256.matches('^[a-f0-9]{64}$')
        && data.createdAt is timestamp && data.updatedAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{uid}/private/snapshot {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && uidUnchanged() && isValidSnapshot(request.resource.data)
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && uidNotModified() && isValidSnapshot(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
